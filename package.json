{
  "name": "x-reader",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "cameliorn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cameliorn/x-reader.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "reader",
    "txt",
    "小说",
    "阅读",
    "写作"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [],
  "contributes": {
    "l10n": "./l10n",
    "viewsContainers": {
      "activitybar": [
        {
          "id": "x-reader",
          "title": "%activityBar.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "x-reader": [
        {
          "id": "xReader.bookshelf",
          "name": "%view.bookshelf.name%",
          "icon": "resources/icons/bookshelf.svg",
          "contextualTitle": "%activityBar.title%"
        },
        {
          "id": "xReader.chapters",
          "name": "%view.chapters.name%",
          "icon": "resources/icons/chapters.svg",
          "contextualTitle": "%activityBar.title%"
        },
        {
          "id": "xReader.summaries",
          "name": "%view.summaries.name%",
          "icon": "resources/icons/summaries.svg",
          "contextualTitle": "%activityBar.title%"
        },
        {
          "id": "xReader.worldbook",
          "name": "%view.worldbook.name%",
          "icon": "resources/icons/worldbook.svg",
          "contextualTitle": "%activityBar.title%"
        },
        {
          "id": "xReader.characters",
          "name": "%view.characters.name%",
          "icon": "resources/icons/characters.svg",
          "contextualTitle": "%activityBar.title%"
        },
        {
          "id": "xReader.notes",
          "name": "%view.notes.name%",
          "icon": "resources/icons/notes.svg",
          "contextualTitle": "%activityBar.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xReader.bookshelf",
        "when": "xReader.noLibrary",
        "contents": "%welcome.bookshelf.noLibrary%"
      },
      {
        "view": "xReader.bookshelf",
        "when": "!xReader.noLibrary && xReader.noBooks",
        "contents": "%welcome.bookshelf.noBooks%"
      },
      {
        "view": "xReader.chapters",
        "when": "!xReader.noBook && xReader.emptyChapters",
        "contents": "%welcome.chapters.empty%"
      },
      {
        "view": "xReader.summaries",
        "when": "!xReader.noBook && xReader.emptyChapters",
        "contents": "%welcome.summaries.empty%"
      },
      {
        "view": "xReader.worldbook",
        "when": "!xReader.noBook && xReader.emptyWorld",
        "contents": "%welcome.worldbook.empty%"
      },
      {
        "view": "xReader.characters",
        "when": "!xReader.noBook && xReader.emptyCards",
        "contents": "%welcome.characters.empty%"
      },
      {
        "view": "xReader.notes",
        "when": "!xReader.noBook && xReader.emptyNotes",
        "contents": "%welcome.notes.empty%"
      }
    ],
    "commands": [
      {
        "command": "xReader.chooseLibraryPath",
        "title": "%command.chooseLibraryPath.title%",
        "category": "X Reader"
      },
      {
        "command": "xReader.importBook",
        "title": "%command.importBook.title%",
        "category": "X Reader",
        "icon": "$(file-add)"
      },
      {
        "command": "xReader.newBook",
        "title": "%command.newBook.title%",
        "category": "X Reader",
        "icon": "$(new-folder)"
      },
      {
        "command": "xReader.openBook",
        "title": "%command.openBook.title%",
        "category": "X Reader",
        "icon": "$(book)"
      },
      {
        "command": "xReader.openChapter",
        "title": "%command.openChapter.title%",
        "category": "X Reader"
      },
      {
        "command": "xReader.openEntry",
        "title": "%command.openEntry.title%",
        "category": "X Reader"
      },
      {
        "command": "xReader.prevChapter",
        "title": "%command.prevChapter.title%",
        "category": "X Reader",
        "icon": "$(chevron-left)"
      },
      {
        "command": "xReader.nextChapter",
        "title": "%command.nextChapter.title%",
        "category": "X Reader",
        "icon": "$(chevron-right)"
      },
      {
        "command": "xReader.removeBook",
        "title": "%command.removeBook.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.deleteEntry",
        "title": "%command.deleteEntry.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.deleteChapter",
        "title": "%command.deleteChapter.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.renameChapter",
        "title": "%command.renameChapter.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.newCharacterCard",
        "title": "%command.newCharacterCard.title%",
        "category": "X Reader",
        "icon": "$(person-add)"
      },
      {
        "command": "xReader.newWorldEntry",
        "title": "%command.newWorldEntry.title%",
        "category": "X Reader",
        "icon": "$(globe)"
      },
      {
        "command": "xReader.newNote",
        "title": "%command.newNote.title%",
        "category": "X Reader",
        "icon": "$(note)"
      },
      {
        "command": "xReader.newChapter",
        "title": "%command.newChapter.title%",
        "category": "X Reader",
        "icon": "$(file-add)"
      },
      {
        "command": "xReader.newVolume",
        "title": "%command.newVolume.title%",
        "category": "X Reader",
        "icon": "$(folder-library)"
      },
      {
        "command": "xReader.renameVolume",
        "title": "%command.renameVolume.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.deleteVolume",
        "title": "%command.deleteVolume.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.deleteChapterSummary",
        "title": "%command.deleteChapterSummary.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.deleteIntervalSummary",
        "title": "%command.deleteIntervalSummary.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.renameNoteCategory",
        "title": "%command.renameNoteCategory.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.deleteNoteCategory",
        "title": "%command.deleteNoteCategory.title%",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.renameBook",
        "title": "%command.renameBook.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.renameEntry",
        "title": "%command.renameEntry.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.renameNote",
        "title": "%command.renameNote.title%",
        "category": "X Reader",
        "icon": "$(edit)"
      },
      {
        "command": "xReader.openChapterSummary",
        "title": "%command.openChapterSummary.title%",
        "category": "X Reader"
      },
      {
        "command": "xReader.openIntervalSummary",
        "title": "%command.openIntervalSummary.title%",
        "category": "X Reader"
      },
      {
        "command": "xReader.snapshot",
        "title": "%command.snapshot.title%",
        "category": "X Reader",
        "icon": "$(git-commit)"
      },
      {
        "command": "xReader.refreshBookshelf",
        "title": "%command.refreshBookshelf.title%",
        "category": "X Reader",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "X Reader",
      "properties": {
        "xReader.libraryPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.libraryPath.description%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "xReader_getCurrentChapter",
        "displayName": "%languageModelTools.getCurrentChapter.displayName%",
        "toolReferenceName": "getCurrentChapter",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "modelDescription": "获取当前正在阅读的书：优先从活动编辑器解析——只要打开的是某本书内的文件（章节/元数据/世界书/角色卡/章节摘要/区间摘要/笔记），即可定位所属书与打开的文件；否则回退当前书架选中的书。返回书文件夹名、书目录、当前打开文件、当前章节（相对路径、序号、标题、是否已有摘要）与进度位置。无参数；先调用它取得上下文，可省略其他工具的 book 参数；要操作其他书时先 xReader_listBooks 或在 book 参数中显式指定书文件夹名。",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "xReader_setProgress",
        "displayName": "%languageModelTools.setProgress.displayName%",
        "toolReferenceName": "setProgress",
        "canBeReferencedInPrompt": true,
        "icon": "$(bookmark)",
        "modelDescription": "把《当前书》的阅读进度设置到指定章节（决定下次打开书时的起始位置，也是 xReader_getCurrentChapter 无编辑器时的回退定位）。chapter 参数可用章节相对路径（如 第一卷/0001-雨夜.md）、文件名或标题。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "chapter": {
              "type": "string",
              "description": "章节相对路径、文件名或标题"
            }
          },
          "required": [
            "chapter"
          ]
        }
      },
      {
        "name": "xReader_listBooks",
        "displayName": "%languageModelTools.listBooks.displayName%",
        "toolReferenceName": "listBooks",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "modelDescription": "列出小说库中的全部书籍（书文件夹名与章节数）。书以文件夹为单位组织。",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "xReader_createBook",
        "displayName": "%languageModelTools.createBook.displayName%",
        "toolReferenceName": "createBook",
        "canBeReferencedInPrompt": true,
        "icon": "$(new-folder)",
        "modelDescription": "新建一本空书（含 元数据.md 与 章节/、世界书/、角色卡/、章节摘要/、区间摘要/、笔记/ 目录骨架），自动设为当前书。name 为新书名，重名时自动加序号。导入已有 txt 小说请让用户使用扩展的「导入小说」命令。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "新书名"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "xReader_listVolumes",
        "displayName": "%languageModelTools.listVolumes.displayName%",
        "toolReferenceName": "listVolumes",
        "canBeReferencedInPrompt": true,
        "icon": "$(library)",
        "modelDescription": "列出小说库中一本书的全部分卷（卷名、目录、章节数）。小说以文件夹为单位组织：章节/ 下的子目录即分卷，根目录章节归入默认卷「第一卷」。book 参数为书文件夹名，省略时使用当前书架选中的书。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            }
          }
        }
      },
      {
        "name": "xReader_listChapters",
        "displayName": "%languageModelTools.listChapters.displayName%",
        "toolReferenceName": "listChapters",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-unordered)",
        "modelDescription": "列出一本书的章节（相对路径、序号、标题、是否已有章节摘要），可按分卷过滤。返回的相对路径可直接作为 readChapterSummary / deleteChapter / renameChapter 等工具的 chapter 参数；章节正文直接用文件工具读取 章节/ 下的 md 文件即可，无需专用工具。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "volume": {
              "type": "string",
              "description": "只列出该分卷（卷名或目录名）的章节"
            }
          }
        }
      },
      {
        "name": "xReader_readChapterSummary",
        "displayName": "%languageModelTools.readChapterSummary.displayName%",
        "toolReferenceName": "readChapterSummary",
        "canBeReferencedInPrompt": true,
        "icon": "$(note)",
        "modelDescription": "读取某章的章节摘要（章节摘要/ 下与章节同名的 md）。chapter 参数可用章节相对路径（如 第一卷/0001-雨夜.md）、文件名或标题。摘要尚未创建时返回应写入的文件路径，可用文件工具撰写后保存到该路径。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "chapter": {
              "type": "string",
              "description": "章节相对路径、文件名或标题"
            }
          },
          "required": [
            "chapter"
          ]
        }
      },
      {
        "name": "xReader_readIntervalSummary",
        "displayName": "%languageModelTools.readIntervalSummary.displayName%",
        "toolReferenceName": "readIntervalSummary",
        "canBeReferencedInPrompt": true,
        "icon": "$(notebook)",
        "modelDescription": "读取区间摘要（区间摘要/ 下每 10 章一个的 md，文件名如 0001-0010.md）。range 参数为区间（如 1-10 或 0001-0010.md），省略时列出全部区间及其摘要是否已建。摘要尚未创建时返回区间章节列表与应写入的文件路径。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "range": {
              "type": "string",
              "description": "区间，如 1-10 或 0001-0010.md；省略时列出全部区间"
            }
          }
        }
      },
      {
        "name": "xReader_createVolume",
        "displayName": "%languageModelTools.createVolume.displayName%",
        "toolReferenceName": "createVolume",
        "canBeReferencedInPrompt": true,
        "icon": "$(folder-library)",
        "modelDescription": "在 章节/ 下创建新分卷子目录。创建后用文件工具移动章节 md 文件即可归卷。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "分卷名，如 第二卷"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "xReader_createChapter",
        "displayName": "%languageModelTools.createChapter.displayName%",
        "toolReferenceName": "createChapter",
        "canBeReferencedInPrompt": true,
        "icon": "$(new-file)",
        "modelDescription": "新建章节 md（序号自动接全书最大值），自动重写全书导航并提交 git 快照。volume 指定分卷（章节/ 下子目录），省略时放章节/ 根目录。创建后用文件工具编辑正文。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "title": {
              "type": "string",
              "description": "章节标题"
            },
            "volume": {
              "type": "string",
              "description": "分卷名或目录名，省略时放章节/ 根目录"
            }
          },
          "required": [
            "title"
          ]
        }
      },
      {
        "name": "xReader_renameVolume",
        "displayName": "%languageModelTools.renameVolume.displayName%",
        "toolReferenceName": "renameVolume",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "modelDescription": "重命名分卷目录，章节摘要/ 下的镜像目录同步更名，并重写全书跨卷导航、迁移进度键与笔记卷前缀。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "oldName": {
              "type": "string",
              "description": "原分卷目录名"
            },
            "newName": {
              "type": "string",
              "description": "新分卷名"
            }
          },
          "required": [
            "oldName",
            "newName"
          ]
        }
      },
      {
        "name": "xReader_deleteVolume",
        "displayName": "%languageModelTools.deleteVolume.displayName%",
        "toolReferenceName": "deleteVolume",
        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "modelDescription": "删除分卷目录及其章节摘要镜像。卷内还有章节时必须将 deleteChapters 设为 true 确认一并删除，否则操作被拒绝。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "分卷目录名"
            },
            "deleteChapters": {
              "type": "boolean",
              "description": "卷内还有章节时，确认一并删除"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "xReader_deleteBook",
        "displayName": "%languageModelTools.deleteBook.displayName%",
        "toolReferenceName": "deleteBook",
        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "modelDescription": "删除整本书文件夹及其全部章节、摘要、笔记等。name 为书文件夹名，删除前会向用户确认。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "书文件夹名（必填）"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "xReader_renameBook",
        "displayName": "%languageModelTools.renameBook.displayName%",
        "toolReferenceName": "renameBook",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "modelDescription": "重命名书籍文件夹（书以文件夹为单位组织），元数据 title、当前选中书与阅读进度同步迁移。book 参数为目标书文件夹名，省略时使用当前书架选中的书；newName 为新书名。请勿用文件工具直接重命名书文件夹，否则会丢失阅读进度关联。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "要重命名的书文件夹名，省略时使用当前书架选中的书"
            },
            "newName": {
              "type": "string",
              "description": "新书名"
            }
          },
          "required": [
            "newName"
          ]
        }
      },
      {
        "name": "xReader_listNotes",
        "displayName": "%languageModelTools.listNotes.displayName%",
        "toolReferenceName": "listNotes",
        "canBeReferencedInPrompt": true,
        "icon": "$(note)",
        "modelDescription": "列出一本书的全部笔记（笔记/ 下，含分类子目录），附关联章节信息。读取与编辑笔记内容直接用文件工具即可。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            }
          }
        }
      },
      {
        "name": "xReader_renameNoteCategory",
        "displayName": "%languageModelTools.renameNoteCategory.displayName%",
        "toolReferenceName": "renameNoteCategory",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "modelDescription": "重命名笔记分类目录（笔记/ 下子目录），目录内笔记随目录迁移。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "oldName": {
              "type": "string",
              "description": "原分类名"
            },
            "newName": {
              "type": "string",
              "description": "新分类名"
            }
          },
          "required": [
            "oldName",
            "newName"
          ]
        }
      },
      {
        "name": "xReader_deleteNoteCategory",
        "displayName": "%languageModelTools.deleteNoteCategory.displayName%",
        "toolReferenceName": "deleteNoteCategory",
        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "modelDescription": "删除笔记分类目录（笔记/ 下子目录）及其全部笔记。删除前会向用户确认。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "分类名"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "xReader_createNote",
