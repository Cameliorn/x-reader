{
  "name": "x-reader",
  "displayName": "X Reader",
  "description": "在 VS Code 中以 Markdown 章节文件阅读小说，并与 Copilot 共创写作",
  "version": "0.1.0",
  "publisher": "xieyuchen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cameliorn/x-reader.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "reader",
    "txt",
    "小说",
    "阅读",
    "写作"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "x-reader",
          "title": "小说阅读",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "x-reader": [
        {
          "id": "xReader.bookshelf",
          "name": "书架",
          "icon": "resources/activity-icon.svg",
          "contextualTitle": "小说阅读"
        },
        {
          "id": "xReader.chapters",
          "name": "章节目录",
          "icon": "resources/activity-icon.svg",
          "contextualTitle": "小说阅读"
        },
        {
          "id": "xReader.worldbook",
          "name": "世界书",
          "icon": "resources/activity-icon.svg",
          "contextualTitle": "小说阅读"
        },
        {
          "id": "xReader.characters",
          "name": "角色卡",
          "icon": "resources/activity-icon.svg",
          "contextualTitle": "小说阅读"
        }
      ]
    },
    "commands": [
      {
        "command": "xReader.importBook",
        "title": "导入小说",
        "category": "X Reader",
        "icon": "$(file-add)"
      },
      {
        "command": "xReader.openBook",
        "title": "打开",
        "category": "X Reader",
        "icon": "$(book)"
      },
      {
        "command": "xReader.openChapter",
        "title": "打开章节",
        "category": "X Reader"
      },
      {
        "command": "xReader.openEntry",
        "title": "打开条目",
        "category": "X Reader"
      },
      {
        "command": "xReader.prevChapter",
        "title": "上一章",
        "category": "X Reader",
        "icon": "$(chevron-left)"
      },
      {
        "command": "xReader.nextChapter",
        "title": "下一章",
        "category": "X Reader",
        "icon": "$(chevron-right)"
      },
      {
        "command": "xReader.removeBook",
        "title": "删除书籍",
        "category": "X Reader",
        "icon": "$(trash)"
      },
      {
        "command": "xReader.newCharacterCard",
        "title": "新建角色卡",
        "category": "X Reader",
        "icon": "$(person-add)"
      },
      {
        "command": "xReader.newWorldEntry",
        "title": "新建世界书条目",
        "category": "X Reader",
        "icon": "$(globe)"
      },
      {
        "command": "xReader.snapshot",
        "title": "保存快照",
        "category": "X Reader",
        "icon": "$(git-commit)"
      },
      {
        "command": "xReader.refreshBookshelf",
        "title": "刷新书架",
        "category": "X Reader",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "X Reader",
      "properties": {
        "xReader.libraryPath": {
          "type": "string",
          "default": "",
          "description": "小说库目录路径（每本书是其中一个文件夹），留空时首次导入弹窗选择"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "xReader.prevChapter",
          "when": "(resourceDirname =~ /章节$/ && resourceFilename =~ /^\\d{4}-.*\\.md$/) || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "xReader.nextChapter",
          "when": "(resourceDirname =~ /章节$/ && resourceFilename =~ /^\\d{4}-.*\\.md$/) || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "xReader.importBook",
          "when": "view == xReader.bookshelf",
          "group": "navigation@1"
        },
        {
          "command": "xReader.snapshot",
          "when": "view == xReader.bookshelf",
          "group": "navigation@2"
        },
        {
          "command": "xReader.refreshBookshelf",
          "when": "view == xReader.bookshelf",
          "group": "navigation@3"
        },
        {
          "command": "xReader.newWorldEntry",
          "when": "view == xReader.worldbook",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newCharacterCard",
          "when": "view == xReader.characters",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "xReader.openBook",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@1"
        },
        {
          "command": "xReader.newCharacterCard",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@2"
        },
        {
          "command": "xReader.newWorldEntry",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@3"
        },
        {
          "command": "xReader.removeBook",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
}
