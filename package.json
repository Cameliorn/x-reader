    "configuration": {
      "title": "X Reader",
      "properties": {
        "xReader.libraryPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.libraryPath.description%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "xReader_getCurrentChapter",
        "displayName": "%languageModelTools.getCurrentChapter.displayName%",
        "toolReferenceName": "getCurrentChapter",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/book.svg",
        "modelDescription": "获取当前正在阅读的书：优先从活动编辑器解析——只要打开的是某本书内的文件（章节/元数据/世界书/角色卡/章节摘要/区间摘要/卷摘要/笔记），即可定位所属书与打开的文件；否则回退当前书架选中的书。返回书文件夹名、书目录、本书 元数据.md 的字段与各小节（简介、说明等，不必再用文件工具读一遍）、当前打开文件、当前章节（相对路径、序号、标题、摘要状态）与进度位置。无参数；先调用它取得上下文，可省略其他工具的 book 参数；要操作其他书时先调用 xReader_listBooks 或在 book 参数中显式指定书文件夹名。",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "xReader_listBooks",
        "displayName": "%languageModelTools.listBooks.displayName%",
        "toolReferenceName": "listBooks",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/bookshelf.svg",
        "modelDescription": "列出小说库中的全部书籍（书文件夹名与章节数）。书以文件夹为单位组织。",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "xReader_listVolumes",
        "displayName": "%languageModelTools.listVolumes.displayName%",
        "toolReferenceName": "listVolumes",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/volume.svg",
        "modelDescription": "列出某本书的分卷（章节/ 下的子目录；章节根目录的文件归入第一项）。返回分卷名、目录名、章节数与卷摘要状态（｜卷摘要✓ = 最新、｜卷摘要待维护 = 卷内章节有改动、｜卷摘要计划 = 卷内还有尚未写正文的计划章节）；只有卷摘要文件、分卷尚未创建的未来卷也会列出（目录显示「分卷尚未创建」）。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            }
          }
        }
      },
      {
        "name": "xReader_listChapters",
        "displayName": "%languageModelTools.listChapters.displayName%",
        "toolReferenceName": "listChapters",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/chapters.svg",
        "modelDescription": "列出某本书的章节（按分卷分组），每行含章节相对路径、序号、标题、摘要状态（｜摘要待维护 = 摘要过期、｜摘要✓ = 最新、无标记 = 未创建）与备选版本数；分卷标题行附该卷的卷摘要状态。volume 可按分卷名 / 目录名过滤。尚未写正文的计划章节不在本清单里，用 readSummary 的 scope=plan 查看。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "volume": {
              "type": "string",
              "description": "只看某个分卷（卷名或目录名，可选）"
            }
          }
        }
      },
      {
        "name": "xReader_readSummary",
        "displayName": "%languageModelTools.readSummary.displayName%",
        "toolReferenceName": "readSummary",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/summaries.svg",
        "modelDescription": "读取摘要：scope=chapter 时用 chapter 指定章节读其章节摘要；scope=interval 时读区间摘要（区间按起止序号记名、长度任意且可重叠，range 用 NNNN-MMMM 或首尾序号指定，省略 range 则列出全部区间与状态）；scope=volume 时读卷摘要（一卷一档，volume 用卷名 / 目录名 / 文件名指定，省略则列出全部卷与状态）；scope=plan 时列出全部计划摘要（目标尚未写全，写入的摘要即计划）。摘要文件未创建时不报错，返回应写入的路径与所需信息，由你用文件工具写入；摘要写入之后目标又有改动时会在内容前提示「已过期」，目标还有没写的章节 / 正文时会提示「这是计划摘要」。计划章节用“序号-标题”形式引用（如 0201-抵达）——序号已被占用时按提示改用 xReader_manageChapter（action=insert，plan=true）在该位置插入计划（其后的章节序号顺延）；正文创建时计划摘要会自动接到同名正文上。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "chapter",
                "interval",
                "volume",
                "plan"
              ],
              "description": "chapter=章节摘要（用 chapter 指定章节）、interval=区间摘要（用 range 指定区间）、volume=卷摘要（用 volume 指定分卷）、plan=列出全部计划摘要"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "chapter": {
              "type": "string",
              "description": "章节（相对路径、文件名或标题；scope=chapter。写计划时用「序号-标题」形式引用尚未创建的章节，如 0201-抵达）"
            },
            "range": {
              "type": "string",
              "description": "区间（如 0011-0020 或 11-20；长度任意、可与其它区间重叠；scope=interval，省略时列出全部区间）"
            },
            "volume": {
              "type": "string",
              "description": "分卷（卷名、目录名或摘要文件名；scope=volume，省略时列出全部卷与状态；分卷尚未创建时给出可预建的卷摘要路径）"
            }
          },
          "required": [
            "scope"
          ]
        }
      },
      {
        "name": "xReader_listEntries",
        "displayName": "%languageModelTools.listEntries.displayName%",
        "toolReferenceName": "listEntries",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/category.svg",
        "modelDescription": "列出条目，用 kind 区分条目类型：world=世界书、character=角色卡、note=笔记。条目按分类分组输出（分类可多级，如 地理/城邦），笔记行附关联章节。三种条目共用同一套分类结构与操作方式。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "kind": {
              "type": "string",
              "enum": [
                "world",
                "character",
                "note"
              ],
              "description": "条目类型：world=世界书、character=角色卡、note=笔记（三处分类与操作完全一致）"
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "xReader_setProgress",
        "displayName": "%languageModelTools.setProgress.displayName%",
        "toolReferenceName": "setProgress",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/bookmark.svg",
        "modelDescription": "设置某本书的阅读进度（章节）。章节用相对路径、文件名或标题引用。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "chapter": {
              "type": "string",
              "description": "章节（相对路径、文件名或标题）"
            }
          },
          "required": [
            "chapter"
          ]
        }
      },
      {
        "name": "xReader_manageBook",
        "displayName": "%languageModelTools.manageBook.displayName%",
        "toolReferenceName": "manageBook",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/new-book.svg",
        "modelDescription": "新建 / 重命名 / 删除书籍（书以文件夹为单位组织），用 action 区分：create 按 name 新建书籍并切换为当前书；rename 把 book 重命名为 newName（book 省略时为当前书；元数据 title、当前选中书与阅读进度同步迁移）；delete 删除 book 及其全部内容（book 省略时为当前书；执行前向用户确认）。请勿用文件工具直接新建 / 改名 / 删除书文件夹，否则会丢失阅读进度关联。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "create",
                "rename",
                "delete"
              ],
              "description": "操作类型：create 用 name 新建｜rename 用 newName 重命名｜delete 删除"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "新书名称（action=create）"
            },
            "newName": {
              "type": "string",
              "description": "新书名称（action=rename）"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "xReader_manageVolume",
        "displayName": "%languageModelTools.manageVolume.displayName%",
        "toolReferenceName": "manageVolume",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/add-volume.svg",
        "modelDescription": "新建 / 重命名 / 删除分卷（章节/ 下的子目录），用 action 区分：create 按 name 新建分卷；rename 把 volume 重命名为 newName（章节摘要镜像、跨卷导航、笔记中的卷名引用与阅读进度同步迁移）；delete 删除 volume，卷内还有章节时必须显式传 deleteChapters=true 才连同章节一起删除；deletePlan 删除卷摘要文件（仅当它是计划：卷内还没有正文、或卷内还有尚未写正文的计划章节；有正文的卷摘要只随分卷删除清理）（执行前向用户确认）。volume 可用卷名或目录名（见 xReader_listVolumes）。章节根目录里散落的章节会被列成一个虚拟卷，它不是真实目录，不能重命名或删除。book 省略时为当前书架选中的书。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "create",
                "rename",
                "delete",
                "deletePlan"
              ],
              "description": "操作类型：create 用 name 新建｜rename 用 newName 重命名｜delete 删除｜deletePlan 删除卷计划摘要（只有卷内还没有正文、或卷内还有计划章节才行）"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "新分卷名（action=create）"
            },
            "volume": {
              "type": "string",
              "description": "目标分卷（卷名或目录名；action=rename/delete/deletePlan）"
            },
            "newName": {
              "type": "string",
              "description": "新分卷名（action=rename）"
            },
            "deleteChapters": {
              "type": "boolean",
              "description": "action=delete 时是否连同卷内章节一起删除（默认 false，卷内有章节时不传会被拒绝）"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "xReader_manageChapter",
        "displayName": "%languageModelTools.manageChapter.displayName%",
        "toolReferenceName": "manageChapter",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/add-chapter.svg",
        "modelDescription": "章节的结构化操作，用 action 区分：create 按 title 新建章节（可选 volume 归入指定分卷，省略时接在全书最后）；insert 在 after 或 before 指定的参照章节前 / 后插入 title（两者只给一个，值为章节相对路径、文件名或标题），也可以直接给 seq 指定章节序号（可落在存量中间或留出空洞）——序号被占用时该序号及其后的正文与计划摘要一并顺延 +1（同步摘要镜像 / 笔记关联 / 进度），同序号若有计划摘要会自动接手成为该章摘要；给 plan=true 时只建「计划章节摘要」而不写正文（位置同样可用 after/before/seq，都不给则接在末尾）；rename 把 chapter 重命名为 newTitle（文件名、相邻导航、摘要镜像、笔记引用与进度同步）；move 把 chapter 移到 volume 分卷（序号不变）；delete 删除 chapter 及其摘要镜像；deletePlan 只删「有摘要无正文」的计划章节摘要（正文对应的摘要不单独删，删章节时才连同清理）（执行前向用户确认）。insert 后返回新章节路径，正文用文件工具写入。注意：不要用文件工具直接新建 / 改名 / 移动 / 删除 章节/ 下的 md，否则导航、摘要镜像、进度与笔记关联会失联。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "create",
                "insert",
                "rename",
                "move",
                "delete",
                "deletePlan"
              ],
              "description": "操作类型：create 用 title 新建｜insert 用 title + after/before/seq 插入｜rename 用 newTitle 改名｜move 用 volume 换分卷｜delete 删除｜deletePlan 删除计划章节摘要（正文尚未创建的计划）"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "title": {
              "type": "string",
              "description": "章节标题（action=create/insert）"
            },
            "seq": {
              "type": "integer",
              "description": "章节序号（action=insert，可代替 after/before 直接指定位置；正整数字号，被占用时其后的章节顺延 +1）"
            },
            "plan": {
              "type": "boolean",
              "description": "action=insert 时只建计划章节摘要（正文留待后写）：位置可用 after/before/seq，都不给则接在全书最后"
            },
            "volume": {
              "type": "string",
              "description": "分卷（卷名或目录名；action=create 指定归入的分卷、action=move 指定目标分卷）"
            },
            "after": {
              "type": "string",
              "description": "插在该章节之后（action=insert；章节相对路径、文件名或标题）"
            },
            "before": {
              "type": "string",
              "description": "插在该章节之前（action=insert；章节相对路径、文件名或标题）"
            },
            "chapter": {
              "type": "string",
              "description": "目标章节（相对路径、文件名或标题；action=rename/move/delete；action=deletePlan 用「序号-标题」引用计划，可带分卷目录）"
            },
            "newTitle": {
              "type": "string",
              "description": "新章节标题（action=rename）"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "xReader_manageChapterVersion",
        "displayName": "%languageModelTools.manageChapterVersion.displayName%",
        "toolReferenceName": "manageChapterVersion",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/version.svg",
        "modelDescription": "章节备选版本（版本/ 下；主版本始终是 章节/ 中的那个文件）管理，用 action 区分：list 列出 chapter 的备选版本；create 把 chapter 当前主版本内容存为备选版本（可选 name 命名）；setPrimary 把 version 设为 chapter 的主版本（原主版本内容自动存回版本库，可用 keepOldName 指定其版本名；切换后章节摘要转为待维护）；delete 删除备选版本（执行前向用户确认）。版本文件内容用文件工具读写。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "create",
                "setPrimary",
                "delete"
              ],
              "description": "操作类型：list 列出备选版本｜create 把当前主版本存为新版本｜setPrimary 设为章节主版本｜delete 删除备选版本"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "chapter": {
              "type": "string",
              "description": "目标章节（相对路径、文件名或标题）"
            },
            "name": {
              "type": "string",
              "description": "新版本名（action=create，省略时自动命名）"
            },
            "version": {
              "type": "string",
              "description": "备选版本名（action=setPrimary/delete）"
            },
            "keepOldName": {
              "type": "string",
              "description": "把原主版本存回版本库时使用的版本名（action=setPrimary，省略为「原版」）"
            }
          },
          "required": [
            "action",
            "chapter"
          ]
        }
      },
      {
        "name": "xReader_manageInterval",
        "displayName": "%languageModelTools.manageInterval.displayName%",
        "toolReferenceName": "manageInterval",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/summary-interval.svg",
        "modelDescription": "区间摘要管理：区间按起止章节序号记名（文件名 NNNN-MMMM.md），长度任意（默认提示的区间为每 10 章一块）、可与其它区间重叠、也可覆盖尚未创建的章节（那时它就是计划）。用 action 区分：create 用 start + end 建区间摘要（已存在不覆盖）；editRange 把 range 指定的区间改成 start–end（文件改名，标题与「章节范围」小节重写，摘要正文保留）；delete 删除区间计划摘要（只有起止越出现存章节范围的计划能删，已覆盖正文的区间改用 editRange 调整起止）（执行前向用户确认）。摘要正文用文件工具写入；没有特定区间时用 readSummary 的 scope=interval 读 / 列。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "create",
                "editRange",
                "delete"
              ],
              "description": "操作类型：create 用 start + end 新建｜editRange 把 range 改成 start–end｜delete 删除计划区间摘要（只有起止越出现存章节范围的计划能删）"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "range": {
              "type": "string",
              "description": "目标区间（如 0011-0020 / 11-20 / 0011-0020.md；action=editRange/delete）"
            },
            "start": {
              "type": "integer",
              "description": "区间起始章节序号（正整数；action=create/editRange）"
            },
            "end": {
              "type": "integer",
              "description": "区间结束章节序号（不小于 start；action=create/editRange）"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "xReader_manageEntry",
        "displayName": "%languageModelTools.manageEntry.displayName%",
        "toolReferenceName": "manageEntry",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/add-note.svg",
        "modelDescription": "条目（kind：world=世界书、character=角色卡、note=笔记）管理，用 action 区分：create 按 name 新建条目（category 指定分类，可多级、不存在时自动创建；kind=note 时可用 chapter 关联章节）；rename 把 name 重命名为 newName；move 把 name 移到 targetCategory 分类（省略表示根目录，目标分类不存在时按路径创建）；delete 删除条目（执行前向用户确认）。分类引用（category / targetCategory）可用完整路径或唯一的末级名，命中现有分类时自动用其规范路径，避免同名分类建到别处；省略表示条目根目录。条目正文用文件工具读写。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "world",
                "character",
                "note"
              ],
              "description": "条目类型：world=世界书、character=角色卡、note=笔记（三处分类与操作完全一致）"
            },
            "action": {
              "type": "string",
              "enum": [
                "create",
                "rename",
                "move",
                "delete"
              ],
              "description": "操作类型：create 新建｜rename 改名｜move 换分类｜delete 删除"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "条目名称（不含扩展名）"
            },
            "category": {
              "type": "string",
              "description": "条目所在分类（完整路径或唯一末级名，可多级如 地理/城邦；省略表示根目录；create 时未命中现有分类则按路径新建）"
            },
            "newName": {
              "type": "string",
              "description": "新名称（action=rename）"
            },
            "targetCategory": {
              "type": "string",
              "description": "目标分类（action=move；完整路径或唯一末级名，可多级；省略表示根目录，未命中现有分类则按路径新建）"
            },
            "chapter": {
              "type": "string",
              "description": "关联章节（action=create 且 kind=note，可选；相对路径、文件名或标题）"
            }
          },
          "required": [
            "kind",
            "action",
            "name"
          ]
        }
      },
      {
        "name": "xReader_manageCategory",
        "displayName": "%languageModelTools.manageCategory.displayName%",
        "toolReferenceName": "manageCategory",
        "canBeReferencedInPrompt": true,
        "icon": "resources/icons/add-category.svg",
        "modelDescription": "条目分类（kind：world=世界书、character=角色卡、note=笔记）管理，用 action 区分：create 按 name 新建分类（支持多级路径，如 地理/城邦，层级按 / 拆开逐级创建）；rename 把 category 重命名为 newName（只改末级名，内容随目录迁移，子分类路径同步）；delete 删除 category 及其全部条目与子分类（执行前向用户确认）。分类就是条目根目录下的目录，可任意层级嵌套。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "world",
                "character",
                "note"
              ],
              "description": "条目类型：world=世界书、character=角色卡、note=笔记（三处分类与操作完全一致）"
            },
            "action": {
              "type": "string",
              "enum": [
                "create",
                "rename",
                "delete"
              ],
              "description": "操作类型：create 新建｜rename 改末级名｜delete 连同内容删除"
            },
            "book": {
              "type": "string",
              "description": "书文件夹名，省略时使用当前书架选中的书"
            },
            "name": {
              "type": "string",
              "description": "新分类路径（action=create，可多级如 地理/城邦）"
            },
            "category": {
              "type": "string",
              "description": "目标分类（完整路径或唯一末级名；action=rename/delete）"
            },
            "newName": {
              "type": "string",
              "description": "新分类名（action=rename，只改末级名）"
            }
          },
          "required": [
            "kind",
            "action"
          ]
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xReader.prevChapter",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "xReader.nextChapter",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@2"
        },
        {
          "command": "xReader.speakChapter",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@3"
        },
        {
          "command": "xReader.speakChapterWithRoles",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@4"
        }
      ],
      "view/title": [
        {
          "command": "xReader.searchBook",
          "when": "view == xReader.bookshelf && !xReader.noLibrary && !xReader.noBooks",
          "group": "navigation@0"
        },
        {
          "command": "xReader.importBook",
          "when": "view == xReader.bookshelf && !xReader.noLibrary",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newBook",
          "when": "view == xReader.bookshelf && !xReader.noLibrary",
          "group": "navigation@2"
        },
        {
          "command": "xReader.snapshot",
          "when": "view == xReader.bookshelf",
          "group": "navigation@3"
        },
        {
          "command": "xReader.newShelf",
          "when": "view == xReader.bookshelf && !xReader.noLibrary",
          "group": "shelf"
        },
        {
          "command": "xReader.exportBook",
          "when": "view == xReader.bookshelf && !xReader.noLibrary && !xReader.noBooks",
          "group": "export"
        },
        {
          "command": "xReader.resetHistory",
          "when": "view == xReader.bookshelf && !xReader.noLibrary",
          "group": "navigation@4"
        },
        {
          "command": "xReader.newWorldEntry",
          "when": "view == xReader.worldbook && !xReader.noBook && !xReader.emptyWorld",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newWorldCategory",
          "when": "view == xReader.worldbook && !xReader.noBook",
          "group": "navigation@2"
        },
        {
          "command": "xReader.newCharacterCard",
          "when": "view == xReader.characters && !xReader.noBook && !xReader.emptyCards",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newCharacterCategory",
          "when": "view == xReader.characters && !xReader.noBook",
          "group": "navigation@2"
        },
        {
          "command": "xReader.newNote",
          "when": "view == xReader.notes && !xReader.noBook && !xReader.emptyNotes",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newNoteCategory",
          "when": "view == xReader.notes && !xReader.noBook",
          "group": "navigation@2"
        },
        {
          "command": "xReader.newChapter",
          "when": "view == xReader.chapters && !xReader.noBook",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newVolume",
          "when": "view == xReader.chapters && !xReader.noBook",
          "group": "navigation@2"
        },
        {
          "command": "xReader.newChapterPlan",
          "when": "view == xReader.summaries && !xReader.noBook",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newIntervalSummary",
          "when": "view == xReader.summaries && !xReader.noBook",
          "group": "navigation@2"
        },
        {
          "command": "xReader.newVolumeSummary",
          "when": "view == xReader.summaries && !xReader.noBook",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "xReader.addBookToShelf",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "0_shelf@1"
        },
        {
          "command": "xReader.newShelf",
          "when": "view == xReader.bookshelf && viewItem == customShelf",
          "group": "inline@0"
        },
        {
          "command": "xReader.renameShelf",
          "when": "view == xReader.bookshelf && viewItem == customShelf",
          "group": "inline@1"
        },
        {
          "command": "xReader.addShelfBook",
          "when": "view == xReader.bookshelf && viewItem == customShelf",
          "group": "inline@2"
        },
        {
          "command": "xReader.deleteShelf",
          "when": "view == xReader.bookshelf && viewItem == customShelf",
          "group": "inline@3"
        },
        {
          "command": "xReader.removeBookFromShelf",
          "when": "view == xReader.bookshelf && viewItem == shelfBook",
          "group": "inline@1"
        },
        {
          "command": "xReader.speakChapter",
          "when": "view == xReader.chapters && viewItem == chapter",
          "group": "0_read@1"
        },
        {
          "command": "xReader.speakChapterWithRoles",
