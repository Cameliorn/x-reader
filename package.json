        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "modelDescription": "删除 角色卡/ 下的角色卡 md。name 为角色名（文件名去扩展名）。删除前会向用户确认。",
        "inputSchema": {
          "type": "object",
