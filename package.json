    ],
    "menus": {
      "editor/title": [
        {
          "command": "xReader.prevChapter",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "xReader.nextChapter",
          "when": "resourcePath =~ /[\\/]章节[\\/]([^\\/]+[\\/])?\\d+-[^\\/]*\\.md$/ || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "xReader.importBook",
          "when": "view == xReader.bookshelf && !xReader.noLibrary && !xReader.noBooks",
          "group": "navigation@1"
        },
        {
          "command": "xReader.snapshot",
          "when": "view == xReader.bookshelf",
          "group": "navigation@2"
        },
        {
          "command": "xReader.refreshBookshelf",
          "when": "view == xReader.bookshelf",
          "group": "navigation@3"
        },
        {
          "command": "xReader.newWorldEntry",
          "when": "view == xReader.worldbook && !xReader.noBook && !xReader.emptyWorld",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newCharacterCard",
          "when": "view == xReader.characters && !xReader.noBook && !xReader.emptyCards",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newNote",
          "when": "view == xReader.notes && !xReader.noBook && !xReader.emptyNotes",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newChapter",
          "when": "view == xReader.chapters && !xReader.noBook",
          "group": "navigation@1"
        },
        {
          "command": "xReader.newVolume",
          "when": "view == xReader.chapters && !xReader.noBook",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "xReader.renameChapter",
          "when": "view == xReader.chapters && viewItem == chapter",
          "group": "inline@1"
        },
        {
          "command": "xReader.deleteChapter",
          "when": "view == xReader.chapters && viewItem == chapter",
          "group": "inline@2"
        },
        {
          "command": "xReader.newChapter",
          "when": "view == xReader.chapters && viewItem == volume",
          "group": "0_new"
        },
        {
          "command": "xReader.renameVolume",
          "when": "view == xReader.chapters && viewItem == volume",
          "group": "inline@1"
        },
        {
          "command": "xReader.deleteVolume",
          "when": "view == xReader.chapters && viewItem == volume",
          "group": "inline@2"
        },
        {
          "command": "xReader.deleteChapterSummary",
          "when": "view == xReader.summaries && viewItem == chapterSummary",
          "group": "inline@1"
        },
        {
          "command": "xReader.deleteIntervalSummary",
          "when": "view == xReader.summaries && viewItem == intervalSummary",
          "group": "inline@1"
        },
        {
          "command": "xReader.renameNoteCategory",
          "when": "view == xReader.notes && viewItem == noteCategory",
          "group": "inline@1"
        },
        {
          "command": "xReader.deleteNoteCategory",
          "when": "view == xReader.notes && viewItem == noteCategory",
          "group": "inline@2"
        },
        {
          "command": "xReader.renameBook",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@1"
        },
        {
          "command": "xReader.newCharacterCard",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@2"
        },
        {
          "command": "xReader.newWorldEntry",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@3"
        },
        {
          "command": "xReader.removeBook",
          "when": "view == xReader.bookshelf && viewItem == book",
          "group": "inline@4"
        },
        {
          "command": "xReader.renameEntry",
          "when": "view == xReader.worldbook && viewItem == entry",
          "group": "inline@1"
        },
        {
          "command": "xReader.renameEntry",
          "when": "view == xReader.characters && viewItem == entry",
          "group": "inline@1"
        },
        {
          "command": "xReader.renameNote",
          "when": "view == xReader.notes && viewItem == note",
          "group": "inline@1"
        },
        {
          "command": "xReader.deleteEntry",
          "when": "view == xReader.worldbook && viewItem == entry",
          "group": "inline@2"
        },
        {
          "command": "xReader.deleteEntry",
          "when": "view == xReader.characters && viewItem == entry",
          "group": "inline@2"
        },
        {
          "command": "xReader.deleteEntry",
          "when": "view == xReader.notes && viewItem == note",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
